{
  "name": "cit-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run check && tsc --noEmit && vite build",
    "check": "node --experimental-strip-types --no-warnings scripts/check-jobs.ts && node --experimental-strip-types --no-warnings scripts/test-rules.ts",
    "dev": "vite",
    "import": "node --experimental-strip-types --no-warnings scripts/import-questions.ts",
    "server": "node --experimental-strip-types --experimental-sqlite --no-warnings server/main.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
